@model RentalEquipmentManagementLogic.Models.Category
@{
    ViewData["Title"] = "Delete Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4 mb-4">Delete Category</h1>

    <div class="alert alert-danger">
        <h4><i class="bi bi-exclamation-triangle-fill me-2"></i> Warning!</h4>
        <p>Are you sure you want to delete this category? This action cannot be undone.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Category Details</h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Description</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to List
                            </a>
                            <div>
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Important Note</h6>
                </div>
                <div class="card-body">
                    <p>Deleting this category will permanently remove it from the system.</p>
                    <p>Categories associated with existing equipment or records may not be deletable directly. Ensure all dependencies are handled first.</p>
                </div>
            </div>
        </div>
    </div>
</div>
