@model RentalEquipmentManagementWebApp.Models.RentalRequest.RentalRequestViewModel
@{
    ViewData["Title"] = "Delete Rental Request";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<h5>Are you sure you want to delete this rental request?</h5>

<div class="border rounded p-3 bg-light mb-3">
    <dl class="row">
        <dt class="col-sm-4">Customer</dt>
        <dd class="col-sm-8">@Model.CustomerName</dd>

        <dt class="col-sm-4">Equipment</dt>
        <dd class="col-sm-8">@Model.EquipmentName</dd>

        <dt class="col-sm-4">Rental Start Date</dt>
        <dd class="col-sm-8">@Model.RentalStartDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-4">Return Date</dt>
        <dd class="col-sm-8">@Model.ReturnDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-4">Total Cost</dt>
        <dd class="col-sm-8">@Model.TotalCost.ToString("C")</dd>

        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4">Description</dt>
        <dd class="col-sm-8">@Model.Description</dd>

        <dt class="col-sm-4">Created At</dt>
        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
