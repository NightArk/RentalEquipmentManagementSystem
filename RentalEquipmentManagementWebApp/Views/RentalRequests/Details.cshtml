@model RentalEquipmentManagementWebApp.Models.RentalRequest.RentalRequestViewModel
@{
    ViewData["Title"] = "Rental Request Details";
}

<div class="container-fluid">
    <h1 class="mt-4 mb-4">Rental Request Details</h1>

    <div class="card shadow mb-4">
        <div class="card-header">
            <h5 class="m-0 font-weight-bold text-primary">Request Info</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Customer Name</dt>
                <dd class="col-sm-9">@Model.CustomerName</dd>

                <dt class="col-sm-3">Equipment</dt>
                <dd class="col-sm-9">@Model.EquipmentName</dd>

                <dt class="col-sm-3">Rental Start Date</dt>
                <dd class="col-sm-9">@Model.RentalStartDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Return Date</dt>
                <dd class="col-sm-9">@Model.ReturnDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Total Cost</dt>
                <dd class="col-sm-9">@Model.TotalCost.ToString("C")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
            </dl>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
