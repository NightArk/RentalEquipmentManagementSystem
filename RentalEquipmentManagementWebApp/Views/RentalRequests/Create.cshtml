@model RentalEquipmentManagementWebApp.Models.RentalRequest.RentalRequestCreateViewModel
@{
    ViewData["Title"] = "Create Rental Request";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" id="rentalRequestForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (ViewBag.IsCustomer)
            {
                <div class="form-group mb-3">
                    <label class="form-label">Customer</label>
                    <input type="text" class="form-control" value="@ViewBag.CustomerName" readonly />
                    <input type="hidden" name="CustomerId" value="@ViewBag.CustomerId" />
                </div>
            }
            else
            {
                <div class="form-group mb-3">
                    <label asp-for="CustomerId" class="form-label">Customer</label>
                    <select asp-for="CustomerId" class="form-control form-select" asp-items="ViewBag.Customers" required>
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
            }

            @if (ViewBag.EquipmentName != null)
            {
                <div class="form-group mb-3">
                    <label class="form-label">Equipment</label>
                    <input type="text" class="form-control" value="@ViewBag.EquipmentName" readonly />
                    <input type="hidden" asp-for="EquipmentId" value="@Model.EquipmentId" />
                </div>
            }
            else
            {
                <div class="form-group mb-3">
                    <label asp-for="EquipmentId" class="form-label">Equipment</label>
                    <select asp-for="EquipmentId" class="form-control form-select" asp-items="ViewBag.Equipment" id="equipmentSelect" required>
                        <option value="">-- Select Equipment --</option>
                    </select>
                    <span asp-validation-for="EquipmentId" class="text-danger"></span>
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" id="StartDate" type="date"
                       min="@Model.StartDate.ToString("yyyy-MM-dd")" required />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ReturnDate" class="form-label"></label>
                <input asp-for="ReturnDate" class="form-control" id="ReturnDate" type="date"
                       min="@Model.ReturnDate.ToString("yyyy-MM-dd")" required />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TotalCost" class="form-label"></label>
                <input asp-for="TotalCost" class="form-control" readonly id="totalCost" />
                <span asp-validation-for="TotalCost" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const equipmentPrices = @Html.Raw(Json.Serialize(ViewBag.EquipmentPrices));

        function calculateTotalCost() {
            try {
                const startDateInput = document.getElementById("StartDate");
                const returnDateInput = document.getElementById("ReturnDate");
                const totalCostInput = document.getElementById("totalCost");

                let equipmentId = "@Model.EquipmentId";

                const equipmentSelect = document.getElementById("equipmentSelect");
                if (equipmentSelect) {
                    equipmentId = equipmentSelect.value;
                }

                const startDate = new Date(startDateInput.value);
                const returnDate = new Date(returnDateInput.value);

                // Update min return date
                if (!isNaN(startDate.getTime())) {
                    const minReturn = new Date(startDate);
                    minReturn.setDate(minReturn.getDate() + 1);
                    returnDateInput.min = minReturn.toISOString().split('T')[0];
                }

                if (!equipmentId || !equipmentPrices[equipmentId] || isNaN(startDate) || isNaN(returnDate)) {
                    totalCostInput.value = "";
                    return;
                }

                const timeDiff = returnDate - startDate;
                let rentalDays = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));
                rentalDays = Math.max(1, rentalDays);

                const dailyRate = equipmentPrices[equipmentId];
                const totalCost = dailyRate * rentalDays;

                totalCostInput.value = totalCost.toFixed(2);
            } catch (err) {
                console.error("Error calculating total cost:", err);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            calculateTotalCost();

            const startDateInput = document.getElementById("StartDate");
            const returnDateInput = document.getElementById("ReturnDate");
            const equipmentSelect = document.getElementById("equipmentSelect");

            if (startDateInput) startDateInput.addEventListener("change", calculateTotalCost);
            if (returnDateInput) returnDateInput.addEventListener("change", calculateTotalCost);
            if (equipmentSelect) equipmentSelect.addEventListener("change", calculateTotalCost);
        });
    </script>
}
