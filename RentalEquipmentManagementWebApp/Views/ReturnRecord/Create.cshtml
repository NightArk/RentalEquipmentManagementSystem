@model RentalEquipmentManagementWebApp.Models.ReturnRecord.CreateReturnRecordViewModel

@{
    ViewData["Title"] = "Create Return Record";
}

<h1>Create Return Record</h1>

<hr />
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Return Record Information</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="RentalTransactionId" class="control-label">Rental Transaction Id</label>
                            <select asp-for="RentalTransactionId" id="RentalTransactionId" class="form-select" asp-items="Model.RentalTransactions" required></select>
                            <span asp-validation-for="RentalTransactionId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CustomerName" class="control-label">Customer Name</label>
                            <input asp-for="CustomerName" id="CustomerName" class="form-control" readonly required />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="EquipmentName" class="control-label">Equipment Name</label>
                            <input asp-for="EquipmentName" id="EquipmentName" class="form-control" readonly required />
                            <span asp-validation-for="EquipmentName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ActualReturnDate" class="control-label">Actual Return Date</label>
                            <input asp-for="ActualReturnDate" class="form-control" type="date" required />
                            <span asp-validation-for="ActualReturnDate" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ReturnCondition" class="control-label">Return Condition</label>
                            <select asp-for="ReturnCondition" class="form-select" asp-items="Model.ReturnConditions" required></select>
                            <span asp-validation-for="ReturnCondition" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="LateReturnFee" class="control-label">Late Return Fee</label>
                            <input asp-for="LateReturnFee" class="form-control" required />
                            <span asp-validation-for="LateReturnFee" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="AdditionalCharges" class="control-label">Additional Charges</label>
                            <input asp-for="AdditionalCharges" class="form-control" required />
                            <span asp-validation-for="AdditionalCharges" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Guidelines</h6>
                </div>
                <div class="card-body">
                    <p>Please provide the following information to create a return record:</p>
                    <ul>
                        <li><strong>Rental Transaction Id:</strong> Select the related rental transaction.</li>
                        <li><strong>Customer Name:</strong> Automatically filled based on transaction.</li>
                        <li><strong>Equipment Name:</strong> Automatically filled based on transaction.</li>
                        <li><strong>Actual Return Date:</strong> The actual date the equipment was returned.</li>
                        <li><strong>Return Condition:</strong> Choose the condition of the equipment upon return.</li>
                        <li><strong>Late Return Fee:</strong> Enter any applicable late fees.</li>
                        <li><strong>Additional Charges:</strong> Enter any additional charges related to the return.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $("#RentalTransactionId").on("change", function () {
                var transactionId = $(this).val();
                if (transactionId) {
                    $.ajax({
                        url: '/ReturnRecord/GetTransactionDetails',
                        type: 'GET',
                        data: { id: transactionId },
                        dataType: 'json',
                        success: function (data) {
                            if (data) {
                                $("#EquipmentName").val(data.equipmentName);
                                $("#CustomerName").val(data.customerName);
                                $('input[type="submit"]').prop('disabled', false);
                            } else {
                                $("#EquipmentName").val('');
                                $("#CustomerName").val('');
                                $('input[type="submit"]').prop('disabled', true);
                            }
                        }
                    });
                } else {
                    $("#EquipmentName").val('');
                    $("#CustomerName").val('');
                    $('input[type="submit"]').prop('disabled', true);
                }
            });

            $('input[type="submit"]').prop('disabled', !$("#RentalTransactionId").val()); // Initially disable if no transaction selected

            // Re-enable if there's a pre-selected value on load (though unlikely in Create)
            if ($("#RentalTransactionId").val()) {
                $("#RentalTransactionId").trigger("change");
            }
        });
    </script>
}
