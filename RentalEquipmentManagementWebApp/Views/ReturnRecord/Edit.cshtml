@model RentalEquipmentManagementWebApp.Models.ReturnRecord.CreateReturnRecordViewModel

@{
    ViewData["Title"] = "Edit Return Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Return Record</h1>

<hr />
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Return Record Information</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="RentalTransactionId" />

                        <div class="mb-3">
                            <label asp-for="RentalTransactionId" class="form-label">Rental Transaction Id</label>
                            <input asp-for="RentalTransactionId" class="form-control" readonly />
                            <span asp-validation-for="RentalTransactionId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EquipmentName" class="form-label">Equipment Name</label>
                            <input asp-for="EquipmentName" class="form-control" readonly />
                            <span asp-validation-for="EquipmentName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label">Customer Name</label>
                            <input asp-for="CustomerName" class="form-control" readonly />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ActualReturnDate" class="form-label">Actual Return Date</label>
                            <input asp-for="ActualReturnDate" class="form-control" type="date" required />
                            <span asp-validation-for="ActualReturnDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ReturnCondition" class="form-label">Return Condition</label>
                            <select asp-for="ReturnCondition" class="form-select" asp-items="Model.ReturnConditions" required>
                            </select>
                            <span asp-validation-for="ReturnCondition" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LateReturnFee" class="form-label">Late Return Fee</label>
                            <input asp-for="LateReturnFee" class="form-control" required />
                            <span asp-validation-for="LateReturnFee" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AdditionalCharges" class="form-label">Additional Charges</label>
                            <input asp-for="AdditionalCharges" class="form-control" required />
                            <span asp-validation-for="AdditionalCharges" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Return Condition Information</h6>
                </div>
                <div class="card-body">
                    <h5>Return Condition</h5>
                    <ul>
                        <li><strong>Excellent:</strong> Like new, no visible wear and tear.</li>
                        <li><strong>Good:</strong> Minor wear and tear, fully functional.</li>
                        <li><strong>Fair:</strong> Noticeable wear, but still functional.</li>
                        <li><strong>Poor:</strong> Significant wear, may have minor functional issues.</li>
                        <li><strong>Damaged:</strong> Has damage that affects functionality.</li>
                    </ul>

                    <h5>Late Return Fees</h5>
                    <ul>
                        <li><strong>Fees:</strong> Applicable if the equipment is returned late based on the rental terms.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
