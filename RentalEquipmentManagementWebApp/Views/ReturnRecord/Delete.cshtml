@model RentalEquipmentManagementWebApp.Models.ReturnRecord.ReturnRecordViewModel

@{
    ViewData["Title"] = "Delete Return Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4 mb-4">Delete Return Record</h1>

    <div class="alert alert-danger">
        <h4><i class="bi bi-exclamation-triangle-fill me-2"></i> Warning!</h4>
        <p>Are you sure you want to delete this?</p>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Return Record Details</h6>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">
                    Return Id
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ReturnId)
                </dd>
                <dt class="col-sm-2">
                    Rental Transaction Id
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.RentalTransactionId)
                </dd>
                <dt class="col-sm-2">
                    Equipment Name
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.EquipmentName)
                </dd>
                <dt class="col-sm-2">
                    Customer Name
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.CustomerName)
                </dd>
                @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                {
                    <dt class="col-sm-2">
                        Customer Email
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.CustomerEmail)
                    </dd>
                }
                <dt class="col-sm-2">
                    Actual Return Date
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ActualReturnDate)
                </dd>
                <dt class="col-sm-2">
                    Return Condition
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ReturnCondition)
                </dd>
                <dt class="col-sm-2">
                    Late Return Fee
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.LateReturnFee)
                </dd>
                <dt class="col-sm-2">
                    Additional Charges
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.AdditionalCharges)
                </dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.ReturnId">
                <input type="hidden" asp-for="ReturnId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>