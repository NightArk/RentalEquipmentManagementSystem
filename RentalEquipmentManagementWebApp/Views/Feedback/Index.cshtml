@model IEnumerable<RentalEquipmentManagementWebApp.Models.Feedback.FeedbackViewModel>
@{
    ViewData["Title"] = "Feedback List";
}

<div class="container-fluid">
    <h1 class="mt-4 mb-4">Feedback</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Feedback List</h6>
        </div>

        <div class="card-body">
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label for="equipmentFilter" class="form-label">Filter by Equipment</label>
                    <select class="form-select" id="equipmentFilter" name="filterEquipmentId">
                        @if (ViewBag.EquipmentList != null)
                        {
                            foreach (var item in (List<SelectListItem>)ViewBag.EquipmentList)
                            {
                                <option value="@item.Value"
                                        selected="@(item.Value == ViewBag.SelectedEquipmentId?.ToString() ? "selected" : null)">
                                    @item.Text
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="userSearch" class="form-label">Search by User Name</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="userSearch" name="searchUserName" value="@ViewBag.UserSearch" placeholder="Search user...">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered" id="feedbackTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Equipment</th>
                            <th>Rating</th>
                            <th>Comment</th>
                            <th>Created At</th>
                            <th>Visibility</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var feedback in Model)
                        {
                            <tr>
                                <td>@feedback.UserName</td>
                                <td>@feedback.EquipmentName</td>
                                <td>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= feedback.Rating)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-warning"></i>
                                        }
                                    }
                                </td>
                                <td>@feedback.Comment</td>
                                <td>@feedback.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (feedback.IsHide)
                                    {
                                        <span class="badge bg-danger">Hidden</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Visible</span>
                                    }
                                </td>
                                <td>
                                    @if (!feedback.IsHide)
                                    {
                                        <form asp-action="Hide" asp-controller="Feedback" method="post" style="display:inline">
                                            <input type="hidden" name="id" value="@feedback.Id" />
                                            <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Are you sure you want to hide this feedback?');">
                                                Hide
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Show" asp-controller="Feedback" method="post" style="display:inline">
                                            <input type="hidden" name="id" value="@feedback.Id" />
                                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Are you sure you want to show this feedback?');">
                                                Show
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#feedbackTable').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]]
            });
        });
    </script>
}
