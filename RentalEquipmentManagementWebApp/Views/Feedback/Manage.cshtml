@model IEnumerable<RentalEquipmentManagementWebApp.Models.Feedback.FeedbackViewModel>
@{
    ViewData["Title"] = "Manage Feedback";
    var equipmentName = ViewBag.EquipmentName as string;
}

<h2>Manage Feedback for @equipmentName</h2>

@if (Model.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>User</th>
                <th>Rating</th>
                <th>Comment</th>
                <th>Created At</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feedback in Model)
            {
                <tr>
                    <td>@feedback.UserName</td>
                    <td>
                        <small>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= feedback.Rating)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-warning"></i>
                                }
                            }
                        </small>
                    </td>
                    <td>@feedback.Comment</td>
                    <td>@feedback.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (feedback.IsHide)
                        {
                            <span class="badge bg-danger">Hidden</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Visible</span>
                        }
                    </td>
                    <td>
                        @if (feedback.IsHide)
                        {
                            <form asp-action="Show" asp-controller="Feedback" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@feedback.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Show</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Hide" asp-controller="Feedback" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@feedback.Id" />
                                <button type="submit" class="btn btn-sm btn-warning">Hide</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No feedback found for this equipment.</div>
}
