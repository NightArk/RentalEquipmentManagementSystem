@model RentalEquipmentManagementWebApp.Models.RentalTransaction.RentalTransactionViewModel

@{
    ViewData["Title"] = "Delete Rental Transaction";
}

<h2>Delete Rental Transaction</h2>
<h3>Are you sure you want to delete this transaction?</h3>
<hr />

<div class="alert alert-danger">
    <strong>Warning!</strong> This action cannot be undone. All associated documents will be permanently deleted.
</div>

<div class="row">
    <!-- Left Column -->
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Transaction ID:</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Customer:</dt>
            <dd class="col-sm-8">@Model.CustomerName</dd>

            <dt class="col-sm-4">Equipment:</dt>
            <dd class="col-sm-8">@Model.EquipmentName</dd>

            <dt class="col-sm-4">Start Date:</dt>
            <dd class="col-sm-8">@Model.ActualRentalStartDate.ToString("d")</dd>
        </dl>
    </div>

    <!-- Right Column -->
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Return Date:</dt>
            <dd class="col-sm-8">@Model.ReturnDate.ToString("d")</dd>

            <dt class="col-sm-4">Total Fee:</dt>
            <dd class="col-sm-8">@Model.RentalFee.ToString("C")</dd>

            <dt class="col-sm-4">Payment Status:</dt>
            <dd class="col-sm-8">
                <span class="badge @GetStatusBadgeClass(Model.PaymentStatus)">
                    @Model.PaymentStatus
                </span>
            </dd>
        </dl>
    </div>
</div>

@if (Model.Documents != null && Model.Documents.Count > 0)
{
    <div class="mt-4">
        <h5>Attached Documents to be Deleted</h5>
        <ul class="list-group">
            @foreach (var doc in Model.Documents)
            {
                <li class="list-group-item">@doc.FileName</li>
            }
        </ul>
    </div>
}

<form asp-action="Delete" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Confirm Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Paid" => "bg-success",
            "Pending" => "bg-warning text-dark",
            "Overdue" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}