@model List<RentalEquipmentManagementWebApp.Models.RentalTransaction.RentalTransactionViewModel>

<div class="container-fluid">
    <h1 class="mt-4 mb-4">Rental Transactions</h1>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" class="form-control" name="customerNameSearch" placeholder="Customer Name" />
        </div>
        <div class="col-md-4">
            <select name="paymentStatusFilter" class="form-select">
                <option value="">All Payment Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
                <option value="Overdue">Overdue</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
    {
        <a asp-action="Create" class="btn btn-success mb-3"><i class="bi bi-plus-circle"></i> Create New</a>
    }

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Equipment</th>
                <th>Start Date</th>
                <th>Return Date</th>
                <th>Fee</th>
                <th>Deposit</th>
                <th>Status</th>
                <th>Documents</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.CustomerName</td>
                    <td>@t.EquipmentName</td>
                    <td>@t.ActualRentalStartDate.ToShortDateString()</td>
                    <td>@t.ReturnDate.ToShortDateString()</td>
                    <td>$@t.RentalFee</td>
                    <td>$@t.Deposit</td>
                    <td>@t.PaymentStatus</td>
                    <td>
                        @if (t.Documents != null && t.Documents.Count > 0)
                        {
                            <ul>
                                @foreach (var doc in t.Documents)
                                {
                                    <li>
                                        <a href="@Url.Action("Download", "RentalTransactions", new { id = doc.Id })">@doc.FileName</a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>No documents available</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-primary"><i class="bi bi-pencil-square"></i></a>
                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                        @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
                        {
                            <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this rental transaction?');"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
