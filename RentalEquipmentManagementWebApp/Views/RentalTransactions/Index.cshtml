@model List<RentalEquipmentManagementWebApp.Models.RentalTransaction.RentalTransactionViewModel>

<div class="container-fluid">
    <h1 class="mt-4 mb-4">Rental Transactions</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Rental Transactions List</h6>
            @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
            {
                <a asp-action="Create" class="btn btn-success btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Create New
                </a>
            }
        </div>

        <div class="card-body">
            <form method="get" class="row g-3 mb-4">
                @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
                {
                    <div class="col-md-4">
                        <input type="text" class="form-control" name="customerNameSearch" placeholder="Customer Name" />
                    </div>
                }
                <div class="col-md-4">
                    <select name="paymentStatusFilter" class="form-select">
                        <option value="">All Payment Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Paid">Paid</option>
                        <option value="Overdue">Overdue</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </form>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No rental transactions found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="rentalTransactionsTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Equipment</th>
                                <th>Start Date</th>
                                <th>Return Date</th>
                                <th>Fee</th>
                                <th>Deposit</th>
                                <th>Status</th>
                                <th>Documents</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td>@t.CustomerName</td>
                                    <td>@t.EquipmentName</td>
                                    <td>@t.ActualRentalStartDate.ToShortDateString()</td>
                                    <td>@t.ReturnDate.ToShortDateString()</td>
                                    <td>$@t.RentalFee</td>
                                    <td>$@t.Deposit</td>
                                    <td>
                                        <span class="badge @GetPaymentStatusBadgeClass(t.PaymentStatus)">
                                            @t.PaymentStatus
                                        </span>
                                    </td>
                                    <td>
                                        @if (t.Documents != null && t.Documents.Count > 0)
                                        {
                                            <ul class="mb-0 ps-3">
                                                @foreach (var doc in t.Documents)
                                                {
                                                    <li>
                                                        <a href="@Url.Action("Download", "RentalTransactions", new { id = doc.Id })">@doc.FileName</a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span>No documents available</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-info btn-sm" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-primary btn-sm" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                            @if (User.IsInRole("Customer") && t.PaymentStatus == "Pending")
                                            {
                                                <a asp-action="Payment" asp-route-id="@t.Id" class="btn btn-success btn-sm" title="Pay">
                                                    <i class="bi bi-credit-card"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#rentalTransactionsTable').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]]
            });
        });
    </script>
}

@functions {
    public string GetPaymentStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Paid" => "bg-success",
            "Overdue" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
